# คัดลอกเป็น .env (root) แล้วใส่ค่าจริง — .env ถูก gitignore แล้ว
# ใช้รหัสผ่านแบบ URL-safe (เช่น hex) เพราะถูกใส่ใน SQLAlchemy connection string

# Linux host: ใส่ผลของ `id -u` เพื่อให้ ./logs เขียนได้ (Windows/Mac ใช้ค่า default ได้)
AIRFLOW_UID=50000

# Postgres metadata DB
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-hex-password
POSTGRES_DB=airflow

# Airflow admin user (สร้างโดย airflow-init)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me

# ต้องเหมือนกันทั้ง webserver และ scheduler
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=replace-with-generated-fernet-key
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-random-hex

# concurrency (optional; default 8/8)
AIRFLOW__CORE__PARALLELISM=8
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=8
